# Environment variables for WaitLess backend
# Copy this file to .env and fill in real values.
# .env must never be committed to git.

# --- Database ---------------------------------------------------------------
# Local development:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/waitless
#
# Supabase (use the SESSION pooler, not the direct connection, because Render
# cannot reach Supabase over IPv6). The password must be URL-encoded.
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/waitless

# SSL mode used when the connection string does not specify `sslmode`.
# Supabase requires "require".
DATABASE_SSL_MODE=prefer

# Connection pool tuning (Supabase's pooler allows few concurrent sessions).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# Database used by the automated test suite.
# Leave empty to reuse the server/credentials from DATABASE_URL but with the
# database name below. The test database is created automatically.
# NOTE: Supabase does not allow CREATE DATABASE, so keep running the test
# suite against a local PostgreSQL installation.
TEST_DATABASE_URL=
TEST_DATABASE_NAME=waitless_test

# --- Security / JWT ---------------------------------------------------------
# Generate a unique value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# The application refuses to start with the placeholder value when
# ENVIRONMENT=production.
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Application ------------------------------------------------------------
DEBUG=True
ENVIRONMENT=development
APP_NAME=WaitLess
API_V1_STR=/api/v1